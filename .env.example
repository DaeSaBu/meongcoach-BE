# 이 파일을 .env로 복사한 뒤 실제 값을 채우세요. .env는 커밋되지 않습니다.
# Spring Boot는 .env를 자동으로 읽지 않으므로 IDE의 환경 변수 설정에 넣거나
# 셸에서 `set -a; source .env; set +a` 후 ./gradlew bootRun 으로 실행하세요.

# JWT 서명 키. 32바이트 이상이어야 하며 기본값이 없어 미설정 시 기동에 실패합니다.
JWT_SECRET=local-dev-secret-key-at-least-32-bytes-long

# 허용할 카카오 id_token의 aud 값. 우리 앱의 키만 넣습니다.
KAKAO_NATIVE_APP_KEY=your-kakao-native-app-key
KAKAO_REST_API_KEY=your-kakao-rest-api-key

# Cloudflare R2 (이미지 업로드 presigned URL 발급용).
# presign은 로컬 서명 연산이라 로컬 개발은 더미 값으로도 기동·발급이 됩니다(실제 업로드만 실패).
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-bucket-name
# 버킷에 연결된 공개 도메인(커스텀 도메인 또는 r2.dev 공개 URL, 끝 슬래시 없이)
R2_PUBLIC_BASE_URL=https://your-public-domain

# AWS S3 (훈련 영상 업로드 presigned URL 발급용).
# 이미지와 마찬가지로 presign은 로컬 서명 연산이라 더미 값으로도 기동·발급이 됩니다(실제 업로드만 실패).
S3_REGION=ap-northeast-2
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
# 가상 호스팅 스타일 URL을 쓰므로 점이 없는 DNS 호환 버킷 이름이어야 합니다
S3_BUCKET=your-video-bucket-name
# 버킷의 공개 도메인(CDN 또는 https://{버킷}.s3.{리전}.amazonaws.com, 끝 슬래시 없이)
S3_PUBLIC_BASE_URL=https://your-video-public-domain

# AWS Bedrock (AI 영상 분석용). Converse가 s3://버킷/키로 영상을 직접 읽으므로
# 이 IAM 사용자에게 bedrock:InvokeModel과 영상 버킷의 s3:GetObject 권한이 함께 필요합니다.
# 클라이언트 생성에는 네트워크 호출이 없어 더미 값으로도 기동은 되며, 실제 분석만 실패합니다.
BEDROCK_REGION=ap-northeast-2
BEDROCK_ACCESS_KEY_ID=your-bedrock-access-key-id
BEDROCK_SECRET_ACCESS_KEY=your-bedrock-secret-access-key
# 미설정 시 amazon.nova-2-lite-v1:0을 씁니다. 영상 입력은 Nova 계열만 지원하며,
# 리전에 따라 인퍼런스 프로파일 ID(예: apac.amazon.nova-2-lite-v1:0)가 필요할 수 있습니다.
# BEDROCK_MODEL=amazon.nova-2-lite-v1:0

# AWS SQS (S3 영상 업로드 완료 이벤트 소비용). S3 presigner와 별개의 자격 증명입니다.
# 로컬 프로파일은 SQS 소비를 꺼 두므로(application-local.yml) 더미 값으로도 기동이 됩니다.
SQS_REGION=ap-northeast-2
SQS_ACCESS_KEY_ID=your-sqs-access-key-id
SQS_SECRET_ACCESS_KEY=your-sqs-secret-access-key
# S3 업로드 이벤트가 들어오는 큐 이름
AI_VIDEO_QUEUE=your-video-event-queue-name

# local은 compose.yml과 일치하는 기본값을 사용합니다. 다른 값이 필요할 때만 설정하세요.
# 배포 환경에서는 ECS task definition의 환경변수와 Secrets Manager 참조로 주입합니다.
# DB_HOST=localhost
# DB_NAME=meongcoach
# DB_USERNAME=meongcoach_local
# DB_PASSWORD=meongcoach-local
