# 이 파일을 .env로 복사한 뒤 실제 값을 채우세요. .env는 커밋되지 않습니다.
# Spring Boot는 .env를 자동으로 읽지 않으므로 IDE의 환경 변수 설정에 넣거나
# 셸에서 `set -a; source .env; set +a` 후 ./gradlew bootRun 으로 실행하세요.

# JWT 서명 키. 32바이트 이상이어야 하며 기본값이 없어 미설정 시 기동에 실패합니다.
JWT_SECRET=local-dev-secret-key-at-least-32-bytes-long

# 허용할 카카오 id_token의 aud 목록(쉼표 구분).
# 네이티브 앱은 네이티브 앱 키, 웹은 REST API 키. 우리 앱의 키만 넣습니다.
KAKAO_AUDIENCES=your-kakao-native-app-key

# 아래 DB 변수는 dev/prod 프로파일 전용입니다. local 프로파일은 인메모리 H2라 DB 설정이 필요 없습니다.
# 배포 환경에서는 ECS task definition의 환경변수와 Secrets Manager 참조로 주입합니다.
# DB_HOST=localhost
# DB_NAME=meongcoach
# DB_USERNAME=username
# DB_PASSWORD=change-me
