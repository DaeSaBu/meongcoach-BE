# 이 파일을 .env로 복사한 뒤 실제 값을 채우세요. .env는 커밋되지 않습니다.
# Spring Boot는 .env를 자동으로 읽지 않으므로 IDE의 환경 변수 설정에 넣거나
# 셸에서 `set -a; source .env; set +a` 후 ./gradlew bootRun 으로 실행하세요.

# JWT 서명 키. 32바이트 이상이어야 하며 기본값이 없어 미설정 시 기동에 실패합니다.
JWT_SECRET=local-dev-secret-key-at-least-32-bytes-long

# 허용할 카카오 id_token의 aud 값. 우리 앱의 키만 넣습니다.
KAKAO_NATIVE_APP_KEY=your-kakao-native-app-key
KAKAO_REST_API_KEY=your-kakao-rest-api-key

# 허용할 애플 id_token의 aud 값. iOS 앱의 번들 ID입니다.
APPLE_BUNDLE_ID=your.ios.bundle.id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-sign-in-with-apple-key-id
# .p8 파일 내용 전체. 줄바꿈은 \n으로 이스케이프한다
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# 허용할 구글 id_token의 aud 값. 안드로이드·서버 검증은 웹 클라이언트 ID, iOS는 iOS 클라이언트 ID입니다.
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Cloudflare R2 (이미지 업로드 presigned URL 발급용).
# presign은 로컬 서명 연산이라 로컬 개발은 더미 값으로도 기동·발급이 됩니다(실제 업로드만 실패).
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-bucket-name
# 버킷에 연결된 공개 도메인(커스텀 도메인 또는 r2.dev 공개 URL, 끝 슬래시 없이)
R2_PUBLIC_BASE_URL=https://your-public-domain

# AWS S3 (실습 인증 영상 업로드 presigned URL 발급용).
# 이미지와 마찬가지로 presign은 로컬 서명 연산이라 더미 값으로도 기동·발급이 됩니다(실제 업로드만 실패).
S3_REGION=ap-northeast-2
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
# 가상 호스팅 스타일 URL을 쓰므로 점이 없는 DNS 호환 버킷 이름이어야 합니다
S3_BUCKET=your-video-bucket-name
# 버킷의 공개 도메인(CDN 또는 https://{버킷}.s3.{리전}.amazonaws.com, 끝 슬래시 없이)
S3_PUBLIC_BASE_URL=https://your-video-public-domain

# Google Cloud (AI 분석 영상 GCS 서명 URL 발급·Pub/Sub 구독·Gemini 파일 등록 공통 서비스 계정).
# 서비스 계정 키 JSON 전체를 base64로 인코딩한 값입니다(`base64 < key.json`). 서명은 로컬 연산이라 형식만 맞으면 기동·발급이 됩니다.
GCP_PROJECT_ID=your-gcp-project-id
GCP_SERVICE_ACCOUNT_KEY=base64-encoded-service-account-key-json
# AI 분석 영상 버킷 이름
GCS_BUCKET=your-ai-video-bucket-name
# GCS 업로드 완료 알림이 들어오는 Pub/Sub pull 구독의 전체 이름.
# 로컬 프로파일은 구독을 꺼 두므로(application-local.yml) 더미 값으로도 기동이 됩니다.
AI_VIDEO_SUBSCRIPTION=projects/your-gcp-project-id/subscriptions/your-video-subscription

# Gemini Developer API (AI 영상 분석용). 영상은 GCS 객체를 등록해 gs:// URI로 전달하므로 Gemini 서비스 에이전트에 버킷 읽기 권한이 있어야 합니다.
# 클라이언트 생성에는 네트워크 호출이 없어 더미 값으로도 기동은 되며, 실제 분석만 실패합니다.
GEMINI_API_KEY=your-gemini-api-key
# 미설정 시 gemini-3.8-flash를 씁니다.
# GEMINI_MODEL=gemini-3.8-flash
# 사고 수준(low·medium·high). 미설정 시 비용·지연 예측을 위해 low를 씁니다.
# GEMINI_THINKING_LEVEL=low

# EvoLink (리포트 제목·AI 플랜 생성용).
# 클라이언트 생성에는 네트워크 호출이 없어 더미 값으로도 기동은 되며, 실제 생성만 실패합니다.
EVOLINK_API_KEY=your-evolink-api-key
# 미설정 시 doubao-seed-2.0-pro를 씁니다.
# EVOLINK_MODEL=doubao-seed-2.0-pro
# 심층 사고 모드(enabled·disabled·auto). 미설정 시 비용·지연 예측을 위해 disabled를 씁니다.
# EVOLINK_THINKING=disabled

# RevenueCat (이용권 동기화용). 대시보드 Project settings > API keys에서 만든 v2 secret 키(customer_information:customers:read 권한)와 프로젝트 ID입니다.
REVENUECAT_API_KEY=your-revenuecat-v2-secret-api-key
REVENUECAT_PROJECT_ID=your-revenuecat-project-id
# 이용권 종류별 RevenueCat entitlement ID(entl로 시작)입니다. 대시보드 Product catalog > Entitlements에서 확인하며, 하나라도 비면 기동에 실패합니다.
REVENUECAT_ENTITLEMENT_ID_PUPPY=your-puppy-entitlement-id
REVENUECAT_ENTITLEMENT_ID_JUNIOR=your-junior-entitlement-id
REVENUECAT_ENTITLEMENT_ID_ADULT=your-adult-entitlement-id
REVENUECAT_ENTITLEMENT_ID_SENIOR=your-senior-entitlement-id

# local은 bastion 호스트 SSH 터널로 dev DB에 접속합니다. 기본값이 없어 미설정 시 기동에 실패합니다.
# 배포 환경에서는 ECS task definition의 환경변수와 Secrets Manager 참조로 주입합니다.
DB_HOST=localhost
DB_NAME=your-dev-db-name
DB_USERNAME=your-dev-db-username
DB_PASSWORD=your-dev-db-password
