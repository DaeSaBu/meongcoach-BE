{
  "type": "object",
  "properties": {
    "observation": {
      "type": "object",
      "description": "내부 근거. 본 것과 들은 것만 짧은 구로",
      "properties": {
        "filming": {
          "type": "object",
          "properties": {
            "setup": {
              "type": "string",
              "enum": [
                "fixed_cam",
                "handheld",
                "edited",
                "unclear"
              ]
            },
            "ownerPresence": {
              "type": "string",
              "enum": [
                "present",
                "likely_absent",
                "unknown"
              ]
            },
            "evidence": {
              "type": "string",
              "description": "촬영 상황과 보호자 존재 판단 근거, 편집 흔적"
            }
          },
          "required": [
            "setup",
            "ownerPresence",
            "evidence"
          ],
          "additionalProperties": false
        },
        "scene": {
          "type": "string",
          "description": "장소, 주거 특징, 낮·밤, 피할 수 없는 상황 여부"
        },
        "dogs": {
          "type": "string",
          "description": "마리 수, 외형, 확실한 나이대, 견종 때문에 판독에서 뺄 신호"
        },
        "timeline": {
          "type": "array",
          "description": "시간 순 최대 8칸. 직전과 직후 포함",
          "items": {
            "type": "object",
            "properties": {
              "t": {
                "type": "string",
                "description": "예: 0:00-0:04"
              },
              "event": {
                "type": "string",
                "description": "개 행동, 소리, 사람 행동을 한 줄로"
              }
            },
            "required": [
              "t",
              "event"
            ],
            "additionalProperties": false
          }
        },
        "sounds": {
          "type": "array",
          "description": "주요 소리 최대 6개",
          "items": {
            "type": "object",
            "properties": {
              "t": {
                "type": "string"
              },
              "sound": {
                "type": "string",
                "description": "발성 종류와 패턴, 또는 들리는 수준의 소리 묘사"
              },
              "source": {
                "type": "string",
                "enum": [
                  "visible_dog",
                  "unclear_dog",
                  "person",
                  "device",
                  "environment",
                  "media_or_bgm",
                  "unknown"
                ]
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              }
            },
            "required": [
              "t",
              "sound",
              "source",
              "confidence"
            ],
            "additionalProperties": false
          }
        },
        "people": {
          "type": "string",
          "description": "신호와 반복 횟수, 보상 타이밍, 접촉, 리드줄, 체벌, 일부러 자극. 없으면 없음"
        },
        "notVisible": {
          "type": "string",
          "description": "판단하지 못한 신호"
        }
      },
      "required": [
        "filming",
        "scene",
        "dogs",
        "timeline",
        "sounds",
        "people",
        "notVisible"
      ],
      "additionalProperties": false
    },
    "interpretation": {
      "type": "object",
      "description": "내부 근거. 이유에 대한 가설",
      "properties": {
        "ownerInfoCheck": {
          "type": "string",
          "description": "보호자 메모의 주장마다: 영상으로 확인 가능한지, 확인되면 일치/불일치, 영상 밖이면 영상 밖. 메모가 없으면 \"입력 없음\""
        },
        "abc": {
          "type": "string",
          "description": "직전 자극 → 행동 → 직후 결과"
        },
        "hypotheses": {
          "type": "array",
          "description": "기능 가설 1~3개, 가능성 높은 순",
          "items": {
            "type": "object",
            "properties": {
              "function": {
                "type": "string"
              },
              "for": {
                "type": "string"
              },
              "against": {
                "type": "string"
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              }
            },
            "required": [
              "function",
              "for",
              "against",
              "confidence"
            ],
            "additionalProperties": false
          }
        },
        "redFlags": {
          "type": "object",
          "properties": {
            "medical": {
              "type": "string",
              "description": "의료 레드플래그 단서. 없으면 없음"
            },
            "biteRisk": {
              "type": "string",
              "enum": [
                "none",
                "low",
                "high"
              ]
            },
            "ownerMethod": {
              "type": "string",
              "description": "사람 쪽 방식의 문제. 없으면 없음"
            }
          },
          "required": [
            "medical",
            "biteRisk",
            "ownerMethod"
          ],
          "additionalProperties": false
        },
        "unknowns": {
          "type": "string",
          "description": "해석을 바꿀 영상 밖 정보 1~2개"
        }
      },
      "required": [
        "ownerInfoCheck",
        "abc",
        "hypotheses",
        "redFlags",
        "unknowns"
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "description": "내부 근거. 유형과 초점",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "no_dog",
            "normal",
            "problem"
          ]
        },
        "criteria": {
          "type": "string",
          "description": "problem이면 해당 기준(a~f)과 근거 한 줄, 아니면 정상 또는 미확인 이유"
        },
        "focus": {
          "type": "string",
          "enum": [
            "dog_behavior",
            "owner_method",
            "medical_first",
            "none"
          ]
        },
        "topicChoice": {
          "type": "string",
          "description": "고른 교육 이름과 기능 연결, 빈 부분. problem이 아니면 없음"
        }
      },
      "required": [
        "type",
        "criteria",
        "focus",
        "topicChoice"
      ],
      "additionalProperties": false
    },
    "recommend": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topicId": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "topicId",
          "title",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "report": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subTitle": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "subTitle",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "solution": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "order": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "order",
          "title",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "title": {
      "type": "string"
    }
  },
  "required": [
    "observation",
    "interpretation",
    "decision",
    "recommend",
    "report",
    "solution",
    "title"
  ],
  "additionalProperties": false
}