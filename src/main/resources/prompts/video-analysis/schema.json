{
  "type": "object",
  "properties": {
    "observation": {
      "type": "object",
      "description": "내부 근거. 본 것과 들은 것만 짧은 구로",
      "properties": {
        "filming": {
          "type": "object",
          "properties": {
            "setup": {
              "type": "string",
              "enum": [
                "fixed_cam",
                "handheld",
                "edited",
                "unclear"
              ]
            },
            "ownerPresence": {
              "type": "string",
              "enum": [
                "present",
                "likely_absent",
                "unknown"
              ]
            },
            "evidence": {
              "type": "string",
              "description": "촬영 상황과 보호자 존재 판단 근거, 편집 흔적"
            }
          },
          "required": [
            "setup",
            "ownerPresence",
            "evidence"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "filming"
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "description": "내부 근거. 유형과 초점",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "no_dog",
            "normal",
            "problem"
          ]
        },
        "certainty": {
          "type": "string",
          "enum": [
            "clear",
            "depends_on_context"
          ]
        },
        "keyFact": {
          "type": "string",
          "description": "depends_on_context이면 해석을 가르는 영상 밖 사실. clear면 없음"
        }
      },
      "required": [
        "type",
        "certainty",
        "keyFact"
      ],
      "additionalProperties": false
    },
    "recommend": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topicId": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "topicId",
          "title",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "report": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subTitle": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "subTitle",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "solution": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "order": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "order",
          "title",
          "description"
        ],
        "additionalProperties": false
